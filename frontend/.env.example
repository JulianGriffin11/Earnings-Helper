# Public backend URL for the Earnings Helper API.
# Only VITE_* variables are exposed to browser code — never put secrets here.
#
# Local development (default):
#   Leave empty or omit this file. The Vite dev server proxies /api to http://localhost:8000.
#
# Production deployment:
#   Set to your deployed FastAPI origin, without a trailing slash.
#   Example: https://api.yourdomain.com
VITE_API_BASE_URL=
