# =============================================================================
# Earnings Helper — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# SEC EDGAR API (required)
# SEC requires a descriptive User-Agent with contact info on every request.
# Format: AppName your-email@example.com
# -----------------------------------------------------------------------------
SEC_USER_AGENT="EarningsHelper your-email@example.com"

# Optional. Same-origin Render deploys do not need this.
# Comma-separated origins for local split dev (Vite on :5173).
CORS_ORIGINS=http://localhost:5173

# Postgres (Supabase or any Postgres). Use the direct URL (port 5432) for migrations.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# App runtime pooler (optional — swap in after migrations; URL-encode special chars in password)
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# OpenAI (Phase 4 — LLM earnings debrief)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Langfuse (LLM observability — optional)
# Project Settings → API Keys in the Langfuse dashboard
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
